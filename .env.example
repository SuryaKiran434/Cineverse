# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a PLACEHOLDER.

# Generate a signing key with: openssl rand -base64 32
SECRET_KEY=replace_with_a_long_random_secret

# Read by database.py (mysql-connector) — these are the ones the app actually uses.
DB_HOST=localhost
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_NAME=cineverse

# SQLAlchemy-style URL, kept for tooling/migrations.
DATABASE_URL=mysql+mysqlconnector://USER:PASSWORD@localhost/cineverse

# TMDB credentials — SERVER-SIDE ONLY. Never ship these to a browser client.
TMDB_API_KEY=replace_me
TMDB_ACCESS_TOKEN=replace_me
